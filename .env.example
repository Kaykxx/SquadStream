# --- Frontend (públicas por natureza: vão para o JavaScript do site) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Apenas no servidor (Vercel > Settings > Environment Variables). NUNCA use prefixo VITE_ ---
# Credenciais TURN temporárias via /api/turn (Metered):
# METERED_APP=meuapp.metered.live
# METERED_SECRET_KEY=
# Fallback estático (só se a API de credenciais não estiver no seu plano):
# TURN_URLS=turn:br.relay.metered.ca:80,turn:br.relay.metered.ca:443,turns:br.relay.metered.ca:443?transport=tcp
# TURN_USERNAME=
# TURN_CREDENTIAL=
